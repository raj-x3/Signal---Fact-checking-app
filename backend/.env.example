# =============================================================================
# SignalCheck Backend - Environment Configuration
# =============================================================================

# Server settings
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Gemma 4 AI Reasoning Engine (Google GenAI)
# -----------------------------------------------------------------------------
# Required for Gemma 4 neural claim decomposition, entity extraction, and synthesis.
# Get an API key from Google AI Studio: https://aistudio.google.com/
GEMMA_API_KEY=
# Fallback alias if using existing Gemini key
GEMINI_API_KEY=
# Model identifier for Gemma 4 (defaults to gemma-4-26b-a4b-it)
GEMMA_MODEL_ID=gemma-4-26b-a4b-it

# -----------------------------------------------------------------------------
# Evidence Search Providers (Optional - graceful fallback provided)
# -----------------------------------------------------------------------------
# Tavily Search API (High-precision web & news search for LLM pipelines)
# Free tier available at: https://tavily.com/
TAVILY_API_KEY=

# Brave Search API (Independent web index without Big Tech bias)
# Free tier available at: https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=

# Google Fact Check Tools API (Discovers ClaimReview fact-checks by IFCN signatories)
# Free API key from Google Cloud Console: https://console.cloud.google.com/
GOOGLE_FACT_CHECK_API_KEY=

# -----------------------------------------------------------------------------
# Public & Specialized Zero-Key Providers (Active by default)
# -----------------------------------------------------------------------------
# - GDELT 2.0 Doc API (Global & Indian News stream)
# - Crossref API (Academic & peer-reviewed metadata)
# - PubMed NCBI E-Utilities (Biomedical & health research)
# - Press Information Bureau (PIB India) & Official Portal Index
# - Indian Independent Fact-Checkers Registry
